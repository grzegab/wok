{{ define "offers/form" }}

{{ template "head" }}
{{ template "header" }}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">{{ .Title }}</h1>
    <a href="/l1st" class="btn btn-outline-secondary">Back</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="POST" action="{{ .Action }}">
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="company_name" class="form-label">Company <span class="text-danger">*</span></label>
                    <input type="text" id="company_name" name="company_name" class="form-control" value="{{ .CompanyName }}" required>
                </div>
                <div class="col-md-3">
                    <label for="application_date" class="form-label">Application date <span class="text-danger">*</span></label>
                    <input type="date" id="application_date" name="application_date" class="form-control" value="{{ .ApplicationDate }}" required>
                </div>
                <div class="col-md-3">
                    <label for="status" class="form-label">Status</label>
                    <select id="status" name="status" class="form-select">
                        <option value="applied" {{ if eq .Status "applied" }}selected{{ end }}>applied</option>
                        <option value="progress" {{ if eq .Status "progress" }}selected{{ end }}>progress</option>
                        <option value="failed" {{ if eq .Status "failed" }}selected{{ end }}>failed</option>
                        <option value="abandon" {{ if eq .Status "abandon" }}selected{{ end }}>abandon</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label for="starting_price" class="form-label">Starting price</label>
                    <input type="number" id="starting_price" name="starting_price" class="form-control" value="{{ .StartingPrice }}">
                </div>
                <div class="col-md-3">
                    <label for="ending_price" class="form-label">Ending price</label>
                    <input type="number" id="ending_price" name="ending_price" class="form-control" value="{{ .EndingPrice }}">
                </div>
                <div class="col-md-3">
                    <label for="my_price" class="form-label">My price</label>
                    <input type="number" id="my_price" name="my_price" class="form-control" value="{{ .MyPrice }}">
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input type="checkbox" id="had_chat" name="had_chat" value="true" class="form-check-input" {{ if .HadChat }}checked{{ end }}>
                        <label for="had_chat" class="form-check-label">Had chat</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <label for="offer_link" class="form-label">Offer link</label>
                    <input type="url" id="offer_link" name="offer_link" class="form-control" value="{{ .OfferLink }}">
                </div>
                <div class="col-md-6">
                    <label for="stack" class="form-label">Stack</label>
                    <input type="text" id="stack" name="stack" class="form-control" value="{{ .Stack }}">
                </div>

                <div class="col-md-6">
                    <label for="outcome" class="form-label">Outcome</label>
                    <textarea id="outcome" name="outcome" class="form-control" rows="3">{{ .Outcome }}</textarea>
                </div>
                <div class="col-md-6">
                    <label for="fixes_after_chat" class="form-label">Fixes after chat</label>
                    <textarea id="fixes_after_chat" name="fixes_after_chat" class="form-control" rows="3">{{ .FixesAfterChat }}</textarea>
                </div>
                <div class="col-md-6">
                    <label for="additional_info" class="form-label">Additional info</label>
                    <textarea id="additional_info" name="additional_info" class="form-control" rows="3">{{ .AdditionalInfo }}</textarea>
                </div>
                <div class="col-md-6">
                    <label for="things_to_fix" class="form-label">Things to fix</label>
                    <textarea id="things_to_fix" name="things_to_fix" class="form-control" rows="3">{{ .ThingsToFix }}</textarea>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a href="/l1st" class="btn btn-link">Cancel</a>
            </div>
        </form>
    </div>
</div>
{{ template "footer" }}
{{ end }}
