{{ define "scraped/list" }}

{{ template "head" }}
{{ template "header" }}

{{ template "categorynav" . }}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th>Title</th>
                <th>Published</th>
                <th>Technologies</th>
                <th>URL</th>
            </tr>
            </thead>
            <tbody>
            {{ range .Possibilities }}
            <tr>
                <td class="fw-medium">{{ .JobTitle }}</td>
                <td class="text-nowrap">{{ .Published }}</td>
                <td>{{ .Tech }}</td>
                <td><a href="{{ .Url }}" target="_blank" rel="noopener noreferrer">{{ .Url }}</a></td>
            </tr>
            {{ else }}
            <tr>
                <td colspan="4" class="text-center text-muted py-5">No scraped offers yet.</td>
            </tr>
            {{ end }}
            </tbody>
        </table>
    </div>
</div>
{{ template "footer" }}
{{ end }}
